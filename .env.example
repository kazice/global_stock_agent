# ──────────────────────────────────────
#  全球龙头行情监控 - 环境变量配置
# ──────────────────────────────────────

# Finnhub API Key (美股/港股/欧股 ADR)
# 免费版: 60次/分钟, 从 https://finnhub.io/ 注册获取
FINNHUB_API_KEY=d8gesfhr01qlgcuj3d20d8gesfhr01qlgcuj3d2g

# J-Quants API Key (日本 TSE 股票)
# 需在 https://jpx-jquants.com/ 注册 → Dashboard 获取 API Key
JQUANTS_API_KEY=

# Stooq API Key (可选, 全球兜底数据源)
# 需在 https://stooq.com 获取 (搜任意股票 → 下载CSV → 复制 apikey 参数)
STOOQ_API_KEY=

# PushPlus Token (微信推送, 选填)
# 从 https://www.pushplus.plus/ 扫码注册 → 个人中心复制 token
PUSHPLUS_TOKEN=

# ──────────────────────────────────────
#  可选配置
# ──────────────────────────────────────

# 关注列表文件路径 (默认: watchlist.json)
WATCHLIST_FILE=watchlist.json

# 缓存目录 (默认: cache)
CACHE_DIR=cache

# 请求间隔秒数 (默认: 0.35)
REQUEST_INTERVAL=0.35

# 报告格式: markdown / text (默认: markdown)
REPORT_FORMAT=markdown

# 是否强制刷新缓存 (1=强制, 0=使用缓存, 默认: 0)
FORCE_REFRESH=0
